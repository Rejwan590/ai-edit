  "look": {
    "palette": { "bg": "#fff7d6", "text": "#111111", "accent": "#ff4d4d", "highlight": "#ffe14a" },
    "fonts": { "heading": "Space Grotesk", "body": "Inter", "bengaliFallback": "Noto Sans Bengali" },
    "captions": { "position": "bc", "size": 44, "uppercase": true, "wordsPerChunk": 4, "highlight": "box", "maxLines": 2 },
    "cards": { "radius": 0, "shadow": true, "position": "right-wall" },
